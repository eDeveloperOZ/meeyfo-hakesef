{
  "name": "meeyfo-hakesef",
  "version": "0.1.0",
  "description": "אתר שקיפות נייטרלי ומבוסס-מקורות למימון מפלגות בישראל",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run build:data",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "lint:neutrality": "tsx scripts/neutrality-lint.ts",
    "typecheck": "npm run build:data && next typegen && tsc --noEmit",
    "validate-data": "tsx scripts/validate-data.ts",
    "build:data": "tsx scripts/build-data.ts",
    "check:links": "tsx scripts/check-links.ts",
    "refresh:report": "tsx scripts/refresh-report.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run validate-data && npm run lint:neutrality && npm run build",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@vercel/analytics": "^1.5.0",
    "csv-parse": "^6.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "1.27.0",
    "next": "15.5.22",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
